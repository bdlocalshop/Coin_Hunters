APP_NAME="Coin Hunters"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL / PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coin_hunters
DB_USERNAME=root
DB_PASSWORD=

# Alternative PostgreSQL Configuration:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=coin_hunters
# DB_USERNAME=postgres
# DB_PASSWORD=

# Session & Authentication
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Sanctum Stateful Domains (SPA on port 3000)
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"

# Cache & Queue Drivers (Redis)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=coin_hunters_cache_

# Redis Configuration (predis client)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@coinhunters.com"
MAIL_FROM_NAME="${APP_NAME}"

# Anti-Fraud & Intelligence Keys
MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key
PROXYCHECK_API_KEY=your_proxycheck_api_key

# Offerwall & Survey Postback Secrets
OFFERWALL_GG_SECRET=your_offerwall_gg_secret
OFFERWALL_COM_SECRET=your_offerwall_com_secret
LOOTABLY_SECRET=your_lootably_secret
BITLABS_SECRET=your_bitlabs_secret
CPX_RESEARCH_SECRET=your_cpx_research_secret
